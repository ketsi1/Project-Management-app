# Copy this file to ".env" and fill in the values when your backend is ready.
# While these are empty, the app uses the built-in demo backend (data saved in your browser).

# Address of your Express API, e.g. http://localhost:4000/api
VITE_API_URL=

# Address of your Socket.IO server for live updates, e.g. http://localhost:4000
VITE_SOCKET_URL=
