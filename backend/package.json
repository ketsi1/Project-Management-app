{
  "name": "pm-backend",
  "version": "1.0.0",
  "description": "Express + Prisma (MySQL) + Socket.IO backend for the PM frontend, written in TypeScript",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:setup": "prisma migrate deploy && node prisma/seed/index.ts all --with-demo",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed/index.ts demo",
    "seed": "node prisma/seed/index.ts all",
    "seed:permissions": "node prisma/seed/index.ts permissions",
    "seed:roles": "node prisma/seed/index.ts roles",
    "seed:admin": "node prisma/seed/index.ts admin",
    "seed:users": "node prisma/seed/index.ts users",
    "seed:demo": "node prisma/seed/index.ts demo",
    "seed:reset": "node prisma/seed/index.ts all --reset",
    "smoke": "node scripts/smoke-test.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.3"
  }
}
