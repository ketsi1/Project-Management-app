{
  "name": "pm-backend",
  "version": "1.0.0",
  "description": "Express + MySQL + Socket.IO backend for the PM frontend",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
