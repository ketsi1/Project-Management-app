# Copy to ".env" and fill in. Every value has a development default except where noted.

# development | production
NODE_ENV=development
PORT=4000

# Browser origins allowed to call the API and open sockets (comma-separated).
# Vite's dev server runs on http://localhost:5173 by default.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Set to true when running behind a reverse proxy (nginx, a load balancer, ...).
TRUST_PROXY=false

# Failed login/register attempts allowed per IP every 15 minutes.
AUTH_RATE_LIMIT=20

# MySQL 8 connection (database/schema.sql creates the database).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pm_database
DB_POOL_SIZE=10

# Secret used to sign login tokens. REQUIRED in production (32+ random characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login lasts before the user must sign in again.
TOKEN_TTL_HOURS=168

# bcrypt cost factor. 12 is a good default; each +1 doubles hashing time.
BCRYPT_ROUNDS=12

# How long invitation links stay valid, and the frontend address used to build them.
INVITE_TTL_HOURS=72
APP_URL=http://localhost:5173
